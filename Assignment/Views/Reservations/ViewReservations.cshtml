@model ReservationListViewModel
@{
    ViewData["Title"] = "Bookings";
}
<div class="d-flex justify-content-between align-items-center mt-3 mb-3">
    <h1 class="h3 mb-0"><i class="fa fa-calendar-check"></i> Bookings</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="fa fa-calendar-plus"></i> New booking</a>
</div>

<form method="get" asp-action="ViewReservations" class="row g-2 mb-3">
    <div class="col-md-5">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Search guest, room or hotel" aria-label="Search" />
    </div>
    <div class="col-md-4">
        <select name="status" class="form-select" aria-label="Status">
            <option value="">All statuses</option>
            @foreach (ReservationStatus s in Enum.GetValues<ReservationStatus>())
            {
                <option value="@s" selected="@(Model.Status == s)">@s.Label()</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-primary w-100"><i class="fa fa-filter"></i> Filter</button>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Guest</th>
                        <th>Hotel / room</th>
                        <th>Check-in</th>
                        <th>Check-out</th>
                        <th class="text-end">Cost</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Reservations)
                    {
                        <tr>
                            <td>
                                @if (r.CustomerId != null)
                                {
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@r.CustomerId"><strong>@r.Name</strong></a>
                                }
                                else
                                {
                                    <strong>@r.Name</strong>
                                }
                                <div class="small text-muted">by @(r.CreatedBy ?? "—")</div>
                            </td>
                            <td>@r.Room.Hotel.Name<div class="small text-muted">Room @r.Room.Name · @r.Room.Type</div></td>
                            <td>@r.From.ToString("dd MMM yyyy HH:mm")</td>
                            <td>@r.To.ToString("dd MMM yyyy HH:mm")</td>
                            <td class="text-end fw-semibold">$@r.Cost.ToString("N2")</td>
                            <td>
                                <span class="badge @r.Status.BadgeClass()">@r.Status.Label()</span>
                                @if (!string.IsNullOrEmpty(r.DecisionNote))
                                {
                                    <div class="small text-muted">@r.DecisionNote</div>
                                }
                            </td>
                            <td><partial name="_ReservationActions" model="r" /></td>
                        </tr>
                    }
                    @if (!Model.Reservations.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No bookings match.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer small text-muted">
        <i class="fa fa-info-circle"></i>
        Bookings made by receptionists wait for an administrator's approval. Pending requests expire automatically once the stay starts,
        and approved bookings that are never checked in become no-shows. Checking out issues the invoice.
    </div>
</div>
