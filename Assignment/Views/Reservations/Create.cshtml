@model CreateReservationViewModel
@inject Microsoft.Extensions.Options.IOptions<Assignment.Services.BillingOptions> Billing
@{
    ViewData["Title"] = "New booking";
    var rooms = (List<Room>)ViewBag.Rooms;
    var selected = ViewBag.SelectedCustomer as Customer;
    bool isAdmin = User.IsInRole(Roles.Admin);
}
<h1 class="h3 mt-3 mb-3"><i class="fa fa-calendar-plus"></i> New booking</h1>
@if (!isAdmin)
{
    <div class="alert alert-info small"><i class="fa fa-info-circle"></i> Your booking will be sent to an administrator for approval.</div>
}

<form id="bookingForm" asp-action="Create" method="post" novalidate
      data-rooms-url="@Url.Action("SearchRooms")" data-lookup-url="@Url.Action("Lookup", "Customers")" data-currency="@Billing.Value.Currency">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="card mb-3">
        <div class="card-header"><i class="fa fa-clock"></i> Stay</div>
        <div class="card-body row g-3">
            <div class="col-md-6">
                <label asp-for="From" class="form-label"></label>
                <input asp-for="From" type="datetime-local" class="form-control" />
                <span asp-validation-for="From" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="To" class="form-label"></label>
                <input asp-for="To" type="datetime-local" class="form-control" />
                <span asp-validation-for="To" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="RoomId" class="form-label"></label>
                <select asp-for="RoomId" class="form-select">
                    <option value="">Choose a room</option>
                    @foreach (var r in rooms)
                    {
                        <option value="@r.RoomId">@r.Hotel.Name — @r.Name (@r.Type, floor @r.Floor) — $@r.Charges.ToString("N2")/day</option>
                    }
                </select>
                <span asp-validation-for="RoomId" class="text-danger small"></span>
                <div id="costEstimate" class="form-text fw-semibold"></div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header"><i class="fa fa-user"></i> Guest</div>
        <div class="card-body">
            <input type="hidden" asp-for="CustomerId" />
            <div class="alert alert-secondary d-flex justify-content-between align-items-center py-2" hidden="@(selected == null)">
                <span><i class="fa fa-user-check"></i> <span id="chosenGuest">@selected?.FullName</span></span>
                <button type="button" id="clearGuest" class="btn btn-sm btn-link">Change</button>
            </div>
            <label for="guestSearch" class="form-label">Find an existing guest</label>
            <input id="guestSearch" class="form-control" placeholder="Type a name, email or phone" autocomplete="off" />
            <div id="guestResults" class="list-group mt-1"></div>

            <div id="newGuestFields" class="row g-3 mt-1" hidden="@(selected != null)">
                <div class="col-12 text-muted small">…or enter a new guest. A profile is created for them automatically.</div>
                <div class="col-md-4">
                    <label asp-for="GuestName" class="form-label"></label>
                    <input asp-for="GuestName" class="form-control" />
                    <span asp-validation-for="GuestName" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="GuestEmail" class="form-label"></label>
                    <input asp-for="GuestEmail" class="form-control" />
                    <span asp-validation-for="GuestEmail" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="GuestPhone" class="form-label"></label>
                    <input asp-for="GuestPhone" class="form-control" />
                    <span asp-validation-for="GuestPhone" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-success"><i class="fa fa-check"></i> @(isAdmin ? "Confirm booking" : "Send for approval")</button>
    <a asp-action="ViewReservations" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="/Scripts/booking.js"></script>
}
