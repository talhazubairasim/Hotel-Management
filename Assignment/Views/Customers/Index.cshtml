@model List<Customer>
@{
    ViewData["Title"] = "Guests";
}
<div class="d-flex justify-content-between align-items-center mt-3 mb-3">
    <h1 class="h3 mb-0"><i class="fa fa-users"></i> Guests</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="fa fa-user-plus"></i> New guest</a>
</div>
<form method="get" class="mb-3 d-flex gap-2">
    <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name, email or phone" aria-label="Search" />
    <button type="submit" class="btn btn-outline-primary">Search</button>
</form>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Name</th><th>Email</th><th>Phone</th><th class="text-end">Bookings</th><th>Since</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@c.CustomerId"><strong>@c.FullName</strong></a></td>
                        <td>@c.Email</td>
                        <td>@c.Phone</td>
                        <td class="text-end">@c.Reservations.Count</td>
                        <td>@c.CreatedAt.ToString("dd MMM yyyy")</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No guests found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
