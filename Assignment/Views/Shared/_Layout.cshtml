@{
    bool signedIn = User.Identity?.IsAuthenticated == true;
    bool isAdmin = User.IsInRole(Roles.Admin);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hotel Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/Content/site.css" />
    <link rel="stylesheet" href="~/Assignment.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-light bg-white border-bottom box-shadow mb-3 fixed-top">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index"><i class="fa fa-hotel"></i> Hotel Management</a>
                @if (signedIn)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                            aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse" id="mainNav">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Index"><i class="fa fa-gauge"></i> Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Reservations" asp-action="ViewReservations"><i class="fa fa-calendar-check"></i> Bookings</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Customers" asp-action="Index"><i class="fa fa-users"></i> Guests</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Invoices" asp-action="Index"><i class="fa fa-file-invoice-dollar"></i> Billing</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Rooms" asp-action="Index"><i class="fa fa-bed"></i> Rooms</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Hotels" asp-action="Index"><i class="fa fa-building"></i> Hotels</a></li>
                        </ul>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(isAdmin ? "bg-danger" : "bg-info text-dark")">@(isAdmin ? Roles.Admin : Roles.Receptionist)</span>
                            <span class="small text-muted">@User.Identity!.Name</span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="fa fa-sign-out-alt"></i> Sign out</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - Hotel Management - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <div id="loaderOverlay" class="loader-overlay" hidden>
        <div class="loader-box">
            <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
            <p class="mt-2">Please wait...</p>
        </div>
    </div>

    <div id="flash" hidden
         data-success="@TempData["SuccessMessage"]"
         data-error="@TempData["ErrorMessage"]"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/Scripts/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
